// src/components/CodingProfiles.astro
import SectionHeading from './SectionHeading.astro';

// ── 1. Fetch GitHub data (fallback provided if offline/rate-limited) ──
interface ContributionDay {
  date: string;
  count: number;
  level: number;
}

let githubTotal = 39;
let githubDays: ContributionDay[] = [];

try {
  const ghRes = await fetch('https://github-contributions-api.jogruber.de/v4/Starhopperr?y=last');
  if (ghRes.ok) {
    const json = await ghRes.json();
    if (json.total?.lastYear !== undefined) {
      githubTotal = json.total.lastYear;
    }
    if (Array.isArray(json.contributions) && json.contributions.length > 0) {
      githubDays = json.contributions;
    }
  }
} catch (e) {
  // Silent fallback
}

// Generate fallback 52-week array if fetch failed
if (githubDays.length === 0) {
  const today = new Date();
  for (let i = 370; i >= 0; i--) {
    const d = new Date(today);
    d.setDate(d.getDate() - i);
    githubDays.push({
      date: d.toISOString().split('T')[0],
      count: 0,
      level: 0,
    });
  }
}

// ── 2. Fetch LeetCode data for 'starhoppersenpai' ────────────────────
let leetcodeStats = {
  totalSolved: 21,
  easy: 16,
  medium: 5,
  hard: 0,
  calendar: {} as Record<string, number>,
};

try {
  const lcRes = await fetch('https://leetcode.com/graphql', {
    method: 'POST',
    headers: {
      'Content-Type': 'application/json',
      'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64)',
      'Referer': 'https://leetcode.com',
    },
    body: JSON.stringify({
      query: `query getUserProfile($username: String!) {
        matchedUser(username: $username) {
          username
          submitStats: submitStatsGlobal {
            acSubmissionNum { difficulty count }
          }
          userCalendar {
            submissionCalendar
          }
        }
      }`,
      variables: { username: 'starhoppersenpai' },
    }),
  });

  if (lcRes.ok) {
    const json = await lcRes.json();
    const user = json?.data?.matchedUser;
    if (user) {
      const nums = user.submitStats?.acSubmissionNum || [];
      const all = nums.find((n: any) => n.difficulty === 'All')?.count;
      const easy = nums.find((n: any) => n.difficulty === 'Easy')?.count;
      const med = nums.find((n: any) => n.difficulty === 'Medium')?.count;
      const hard = nums.find((n: any) => n.difficulty === 'Hard')?.count;

      if (all !== undefined) leetcodeStats.totalSolved = all;
      if (easy !== undefined) leetcodeStats.easy = easy;
      if (med !== undefined) leetcodeStats.medium = med;
      if (hard !== undefined) leetcodeStats.hard = hard;

      if (user.userCalendar?.submissionCalendar) {
        leetcodeStats.calendar = JSON.parse(user.userCalendar.submissionCalendar);
      }
    }
  }
} catch (e) {
  // Silent fallback to confirmed stats
}

// ── 3. Fetch Codeforces data for 'SukumarRoy' ────────────────────────
interface CFRatingChange {
  contestId: number;
  contestName: string;
  handle: string;
  rank: number;
  ratingUpdateTimeSeconds: number;
  oldRating: number;
  newRating: number;
}

let codeforcesStats = {
  handle: 'SukumarRoy',
  rank: 'Newbie',
  rating: 368,
  maxRating: 368,
  solved: 3,
  totalSubmissions: 9,
  calendar: {} as Record<string, number>,
};

let codeforcesRatings: CFRatingChange[] = [
  {
    contestId: 2232,
    contestName: 'Codeforces Round 1101 (Div. 2)',
    handle: 'SukumarRoy',
    rank: 14318,
    ratingUpdateTimeSeconds: 1780158900,
    oldRating: 0,
    newRating: 368,
  },
];

try {
  const [infoRes, ratingRes, statusRes] = await Promise.all([
    fetch('https://codeforces.com/api/user.info?handles=SukumarRoy'),
    fetch('https://codeforces.com/api/user.rating?handle=SukumarRoy'),
    fetch('https://codeforces.com/api/user.status?handle=SukumarRoy&from=1&count=500'),
  ]);

  if (infoRes.ok) {
    const infoJson = await infoRes.json();
    if (infoJson.status === 'OK' && Array.isArray(infoJson.result) && infoJson.result.length > 0) {
      const u = infoJson.result[0];
      if (u.rating !== undefined) codeforcesStats.rating = u.rating;
      if (u.maxRating !== undefined) codeforcesStats.maxRating = u.maxRating;
      if (u.rank) {
        codeforcesStats.rank = u.rank.charAt(0).toUpperCase() + u.rank.slice(1);
      }
    }
  }

  if (ratingRes.ok) {
    const ratingJson = await ratingRes.json();
    if (ratingJson.status === 'OK' && Array.isArray(ratingJson.result) && ratingJson.result.length > 0) {
      codeforcesRatings = ratingJson.result;
    }
  }

  if (statusRes.ok) {
    const statusJson = await statusRes.json();
    if (statusJson.status === 'OK' && Array.isArray(statusJson.result)) {
      codeforcesStats.totalSubmissions = statusJson.result.length;
      const solvedSet = new Set<string>();
      statusJson.result.forEach((sub: any) => {
        if (sub.verdict === 'OK' && sub.problem) {
          solvedSet.add(`${sub.problem.contestId}-${sub.problem.index}`);
        }
        if (sub.creationTimeSeconds) {
          const d = new Date(sub.creationTimeSeconds * 1000);
          const dateStr = d.toISOString().split('T')[0];
          codeforcesStats.calendar[dateStr] = (codeforcesStats.calendar[dateStr] || 0) + 1;
        }
      });
      if (solvedSet.size > 0) {
        codeforcesStats.solved = solvedSet.size;
      }
    }
  }
} catch (e) {
  // Silent fallback
}

// Ensure confirmed dates exist in Codeforces calendar if offline
if (Object.keys(codeforcesStats.calendar).length === 0) {
  codeforcesStats.calendar['2025-04-13'] = 8;
  codeforcesStats.calendar['2026-05-30'] = 1;
}

// ── Graph Calculations for Codeforces Rating View ───────────────────
const originX = 60;
const originY = 20;
const graphWidth = 715;
const graphHeight = 260;
const maxRatingCap = 2100;

function formatContestDate(epochSec: number): string {
  const d = new Date(epochSec * 1000);
  const day = d.getUTCDate();
  const months = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
  const month = months[d.getUTCMonth()];
  const year = d.getUTCFullYear();
  return `${day} ${month} ${year}`;
}

function ratingToY(rating: number): number {
  const clamped = Math.max(0, Math.min(maxRatingCap, rating));
  return originY + graphHeight - (clamped / maxRatingCap) * graphHeight;
}

// Band coordinates (Y and Height)
const y2100 = ratingToY(2100);
const y1900 = ratingToY(1900);
const y1600 = ratingToY(1600);
const y1400 = ratingToY(1400);
const y1200 = ratingToY(1200);
const y0 = ratingToY(0);

const bandCM = { y: y2100, h: y1900 - y2100 };
const bandExp = { y: y1900, h: y1600 - y1900 };
const bandSpec = { y: y1600, h: y1400 - y1600 };
const bandPupil = { y: y1400, h: y1200 - y1400 };
const bandNewbie = { y: y1200, h: y0 - y1200 };

// Contest Points
const contestPoints = codeforcesRatings.map((c, idx) => {
  let x = originX + graphWidth / 2;
  if (codeforcesRatings.length > 1) {
    x = originX + 50 + (idx / (codeforcesRatings.length - 1)) * (graphWidth - 100);
  }
  const y = ratingToY(c.newRating);
  const dateStr = formatContestDate(c.ratingUpdateTimeSeconds);
  const delta = c.newRating - c.oldRating;
  const deltaStr = delta >= 0 ? `+${delta}` : `${delta}`;
  return {
    ...c,
    x,
    y,
    dateStr,
    deltaStr,
  };
});

const linePointsStr = contestPoints.map((p) => `${p.x},${p.y}`).join(' ');

// ── Calendar Grids for GitHub, LeetCode & Codeforces ────────────────
const ghWeeks: ContributionDay[][] = [];
for (let i = 0; i < githubDays.length; i += 7) {
  ghWeeks.push(githubDays.slice(i, i + 7));
}

const lcDays: { date: string; count: number; level: number }[] = githubDays.map((day) => {
  const dateObj = new Date(day.date + 'T00:00:00Z');
  const epochSec = Math.floor(dateObj.getTime() / 1000);
  const count = leetcodeStats.calendar[epochSec.toString()] || 0;
  let level = 0;
  if (count >= 7) level = 4;
  else if (count >= 4) level = 3;
  else if (count >= 2) level = 2;
  else if (count >= 1) level = 1;
  return { date: day.date, count, level };
});

const lcWeeks: typeof lcDays[] = [];
for (let i = 0; i < lcDays.length; i += 7) {
  lcWeeks.push(lcDays.slice(i, i + 7));
}

// Codeforces 52-week activity calendar (blue scale)
const cfDays: { date: string; count: number; level: number }[] = githubDays.map((day) => {
  const count = codeforcesStats.calendar[day.date] || 0;
  let level = 0;
  if (count >= 5) level = 4;
  else if (count >= 3) level = 3;
  else if (count >= 2) level = 2;
  else if (count >= 1) level = 1;
  return { date: day.date, count, level };
});

const cfWeeks: typeof cfDays[] = [];
for (let i = 0; i < cfDays.length; i += 7) {
  cfWeeks.push(cfDays.slice(i, i + 7));
}
