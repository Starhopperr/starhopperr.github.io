                    </text>

                    <g class="cf-tooltip" transform={`translate(${p.x}, ${Math.max(35, p.y - 75)})`}>
                      <rect
                        x="-95"
                        y="-12"
                        width="190"
                        height="64"
                        rx="8"
                        class="cf-tooltip-box"
                      />
                      <text x="0" y="8" text-anchor="middle" class="cf-tt-title mono">
