            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Client Script for Live Codeforces Sync & Tab Switcher -->
<script>
  function setupCodeforcesInteractions() {
    // 1. Tab Switcher
    const tabBtns = document.querySelectorAll<HTMLButtonElement>('.cf-tab-btn');
    const heatmapView = document.getElementById('cf-heatmap-view');
    const graphView = document.getElementById('cf-graph-view');

    tabBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        tabBtns.forEach((b) => {
          b.classList.remove('active');
          b.setAttribute('aria-selected', 'false');
        });

        btn.classList.add('active');
        btn.setAttribute('aria-selected', 'true');
        const target = btn.getAttribute('data-target');

        if (target === 'cf-heatmap-view') {
          if (heatmapView) {
            heatmapView.classList.add('active');
            heatmapView.style.display = 'block';
          }
          if (graphView) {
            graphView.classList.remove('active');
            graphView.style.display = 'none';
          }
        } else if (target === 'cf-graph-view') {
          if (graphView) {
            graphView.classList.add('active');
            graphView.style.display = 'block';
          }
          if (heatmapView) {
            heatmapView.classList.remove('active');
            heatmapView.style.display = 'none';
          }
        }
      });
    });

    // 2. Live Sync
    async function syncCodeforcesLive() {
      const syncText = document.getElementById('cf-sync-text');
      const syncDot = document.querySelector('.sync-dot');
      const ratingVal = document.getElementById('cf-rating-val');
      const rankVal = document.getElementById('cf-rank-val');

      try {
        const [uRes, rRes] = await Promise.all([
          fetch('https://codeforces.com/api/user.info?handles=SukumarRoy'),
          fetch('https://codeforces.com/api/user.rating?handle=SukumarRoy')
        ]);

        if (uRes.ok) {
          const uData = await uRes.json();
          if (uData.status === 'OK' && uData.result?.[0]) {
            const u = uData.result[0];
            if (ratingVal && u.rating !== undefined) ratingVal.textContent = u.rating.toString();
            if (rankVal && u.rank) {
              rankVal.textContent = u.rank.charAt(0).toUpperCase() + u.rank.slice(1);
            }
          }
        }

        if (rRes.ok) {
          const rData = await rRes.json();
          if (rData.status === 'OK' && Array.isArray(rData.result)) {
            if (syncText) syncText.textContent = 'Live (Synced)';
            if (syncDot) syncDot.classList.add('synced');
          }
        }
      } catch (e) {
        if (syncText) syncText.textContent = 'Live Cache';
      }
    }

    syncCodeforcesLive();
  }

  if (typeof window !== 'undefined') {
    setupCodeforcesInteractions();
  }
</script>

