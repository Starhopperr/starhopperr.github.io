                      </text>
                      <text x="0" y="42" text-anchor="middle" class="cf-tt-rating mono">
                        Rating: <tspan class="cf-tt-bold">{p.newRating}</tspan> ({p.deltaStr})
                      </text>
                    </g>
                  </g>
                ))}
              </g>
            </svg>
          </div>

          <div class="heatmap-footer">
