---
// src/pages/blogs/index.astro
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('blog', ({ data }) => !data.draft);
const sorted = posts.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
---

<BaseLayout
  title="Blogs"
  description="Cybersecurity research, threat intelligence analysis and technical writing by Mainak Sarkar — covering malware, cryptography, vulnerability research and security engineering."
>
  <SiteHeader />

  <main id="main-content">
    <div class="container page-header">
      <SectionHeading
        eyebrow="Research &amp; Writing"
        heading="Blogs"
        description="Original technical writing on cybersecurity research, threat intelligence, cryptography and security engineering."
      />
    </div>

    <div class="container">
      {sorted.length === 0 ? (
        <div class="empty-state">
          <p class="mono">— Articles coming soon —</p>
          <p>The first article is in progress. Subscribe to the RSS feed to be notified when it publishes.</p>
          <a href="/rss.xml" class="rss-btn">RSS Feed</a>
        </div>
      ) : (
        <div class="articles-grid">
          {sorted.map(post => (
            <ArticleCard
              title={post.data.title}
              description={post.data.description}
              pubDate={post.data.pubDate}
              category={post.data.category}
              tags={post.data.tags}
              slug={post.slug}
              heroImage={post.data.heroImage}
            />
          ))}
        </div>
      )}
    </div>
  </main>

  <SiteFooter />
</BaseLayout>

<style>
  .page-header {
    padding-top: var(--space-1000);
    padding-bottom: var(--space-500);
  }

  .articles-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: var(--layout-grid-gap);
    padding-bottom: var(--space-1000);
  }

  .empty-state {
    text-align: center;
    padding: var(--space-1000) 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-300);
  }

  .empty-state .mono {
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: var(--font-size-label);
    letter-spacing: var(--tracking-label);
  }

  .empty-state p {
    color: var(--color-text-secondary);
    max-width: 40ch;
  }

  .rss-btn {
    display: inline-flex;
    align-items: center;
    padding: var(--space-100) var(--space-300);
    border-radius: var(--radius-pill);
    border: 1px solid var(--color-border-strong);
    color: var(--color-text-primary);
    font-size: var(--font-size-body-s);
    font-weight: var(--font-weight-medium);
    transition: background var(--motion-fast) var(--motion-easing);
  }

  .rss-btn:hover {
    background: var(--color-bg-surface);
  }
</style>
