---
// src/pages/index.astro — Homepage
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ArticleCard from '../components/ArticleCard.astro';
import CodingProfiles from '../components/CodingProfiles.astro';
import { getCollection } from 'astro:content';

const allProjects = await getCollection('projects', ({ data }) => !data.draft);
const featuredProjects = allProjects
  .filter(p => p.data.featured)
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const featuredPosts = allPosts
  .filter(p => p.data.featured)
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
  .slice(0, 3);

const recentPosts = allPosts
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
  .slice(0, 3);

const displayPosts = featuredPosts.length > 0 ? featuredPosts : recentPosts;

const skills = [
  { group: 'Security Research',          items: ['Threat Intelligence', 'Malware Analysis', 'Vulnerability Research', 'Red Teaming', 'SOC / SIEM'] },
  { group: 'Cryptography & PQC',         items: ['Signal Protocol', 'Post-Quantum Crypto', 'Secure Messaging', 'QKD'] },
  { group: 'Programming & Systems',      items: ['Java', 'Python', 'C++', 'Linux', 'Git'] },
  { group: 'AI / ML',                    items: ['Transformers', 'PyTorch', 'XAI', 'NLP'] },
];
---

<BaseLayout
  title="Mainak Sarkar"
  description="Mainak Sarkar — Cybersecurity researcher and security engineer. B.Tech CSE (Cybersecurity) at Bennett University. Exploring threat intelligence, post-quantum cryptography and security engineering."
>
  <SiteHeader />

  <main id="main-content">

    <!-- ── Hero ─────────────────────────────────────────────── -->
    <section class="hero section" aria-labelledby="hero-heading">
      <div class="container hero-inner">
        <div class="hero-text">
          <p class="hero-eyebrow mono" aria-hidden="true">
            <span class="status-dot" aria-hidden="true"></span>
            B.Tech CSE · Cybersecurity · Bennett University
          </p>

          <h1 id="hero-heading" class="hero-heading">Mainak<br/>
          <span class="hero-heading-accent">Sarkar <span class="hero-heading-sub">(AKA Starhopper Senpai)</span></span>
          </h1>
          

          <p class="hero-tagline">
            Cybersecurity researcher. Security engineer. I study threats,
            break cryptographic assumptions and build systems that communicate
            securely even against future post-quantum adversaries.
          </p>

          <div class="hero-actions">
            <a href="/projects/" class="btn btn--primary">
              Explore my work
            </a>
            <a href="/projects/kokborok-nmt/" class="btn btn--secondary">
              Read research
            </a>
          </div>
        </div>

        <div class="hero-portrait">
          <div class="portrait-halo" aria-hidden="true"></div>
          <div class="portrait-frame">
            <img
              src="/images/profile.png"
              alt="Mainak Sarkar"
              width="360"
              height="360"
              loading="eager"
              fetchpriority="high"
            />
          </div>
        </div>
      </div>
    </section>

    <!-- ── Focus areas ───────────────────────────────────────── -->
    <section class="section focus-section" aria-labelledby="focus-heading">
      <div class="container">
        <SectionHeading
          eyebrow="What I work on"
          heading="Research Focus"
          description="My work sits at the intersection of security research, applied cryptography and security engineering."
          id="focus-heading"
        />

        <div class="skills-grid">
          {skills.map(group => (
            <div class="skill-group">
              <h3 class="skill-group-title mono">{group.group}</h3>
              <div class="skill-tags">
                {group.items.map(item => (
                  <span class="skill-tag">{item}</span>
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ── Projects ──────────────────────────────────────────── -->
    {featuredProjects.length > 0 && (
      <section class="section" aria-labelledby="projects-heading">
        <div class="container">
          <SectionHeading
            eyebrow="Selected work"
            heading="Projects"
            id="projects-heading"
          />
          <div class="projects-grid">
            {featuredProjects.map(project => (
              <ProjectCard
                title={project.data.title}
                description={project.data.description}
                status={project.data.status}
                technologies={project.data.technologies}
                repositoryURL={project.data.repositoryURL}
                demoURL={project.data.demoURL}
                coverImage={project.data.coverImage}
                slug={project.slug}
                variant="featured"
                isResearch={project.data.isResearch}
                doiURL={project.data.doiURL}
              />
            ))}
          </div>
          <div class="section-cta">
            <a href="/projects/" class="btn btn--secondary">View all projects →</a>
          </div>
        </div>
      </section>
    )}

    <!-- ── Blog ─────────────────────────────────────────────── -->
    {displayPosts.length > 0 && (
      <section class="section" aria-labelledby="blog-heading">
        <div class="container">
          <SectionHeading
            eyebrow="Research & writing"
            heading="Latest Articles"
            id="blog-heading"
          />
          <div class="articles-grid">
            {displayPosts.map(post => (
              <ArticleCard
                title={post.data.title}
                description={post.data.description}
                pubDate={post.data.pubDate}
                category={post.data.category}
                tags={post.data.tags}
                slug={post.slug}
                heroImage={post.data.heroImage}
              />
            ))}
          </div>
          <div class="section-cta">
            <a href="/blogs/" class="btn btn--secondary">View all articles →</a>
          </div>
        </div>
      </section>
    )}

    <!-- ── Coding Profiles ───────────────────────────────────── -->
    <CodingProfiles />

    <!-- ── About snapshot ────────────────────────────────────── -->
    <section class="section about-snapshot" aria-labelledby="about-heading">
      <div class="container">
        <div class="about-inner">
          <div class="about-text">
            <SectionHeading
              eyebrow="About"
              heading="Who I am"
              id="about-heading"
            />
            <p>
              I'm Mainak Sarkar, a second-year B.Tech Computer Science and
              Engineering student specialising in Cybersecurity at Bennett
              University (class of 2028). I focus on threat intelligence,
              applied cryptography, security operations and security
              engineering.
            </p>
            <p>
              Alongside coursework, I conduct independent security research —
              exploring topics from malware analysis and secure messaging
              protocols to post-quantum cryptography. My published work
              includes a book chapter on low-resource neural machine
              translation for the Kokborok language.
            </p>
            <div class="about-actions">
              <a href="/about/" class="btn btn--secondary">More about me →</a>
            </div>
          </div>

          <div class="about-card">
            <div class="about-card-inner">
              <div class="about-stat">
                <span class="stat-value mono">2024–2028</span>
                <span class="stat-label">B.Tech CSE, Cybersecurity</span>
              </div>
              <div class="about-stat">
                <span class="stat-value mono">1</span>
                <span class="stat-label">Published book chapter</span>
              </div>
              <div class="about-stat">
                <span class="stat-value mono">3+</span>
                <span class="stat-label">Active security projects</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ── Contact CTA ───────────────────────────────────────── -->
    <section class="section contact-cta" aria-labelledby="contact-cta-heading">
      <div class="container">
        <div class="cta-inner">
          <h2 id="contact-cta-heading" class="cta-heading">
            Interested in collaborating?
          </h2>
          <p class="cta-body">
            I'm open to research collaborations, security discussions and
            internship opportunities in cybersecurity.
          </p>
          <a href="/contact/" class="btn btn--primary">
            Get in touch
          </a>
        </div>
      </div>
    </section>

  </main>

  <SiteFooter />
</BaseLayout>

<style>
  /* ── Hero ──────────────────────────────────────────────────── */
  .hero { padding-block: var(--space-1000) var(--layout-section-desktop); }

  .hero-inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-800);
    align-items: center;
    width: 100%;
  }

  @media (min-width: 1024px) {
    .hero-inner {
      grid-template-columns: minmax(0, 1.25fr) minmax(280px, 0.75fr);
      align-items: center;
    }
  }

  .hero-text {
    display: flex;
    flex-direction: column;
    gap: var(--space-400);
    min-width: 0;
  }

  .hero-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: var(--space-150);
    color: var(--color-text-secondary);
    font-size: var(--font-size-label);
    width: fit-content;
  }

  .status-dot {
    display: inline-block;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--color-accent);
    box-shadow: 0 0 8px var(--color-accent);
    animation: pulse 2.5s ease-in-out infinite;
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.4; }
  }

  @media (prefers-reduced-motion: reduce) {
    .status-dot { animation: none; }
  }

  .hero-heading {
    font-size: var(--font-size-display);
    font-weight: var(--font-weight-bold);
    line-height: var(--line-height-tight);
    letter-spacing: var(--tracking-display);
    color: var(--color-text-primary);
  }

  .hero-heading-accent {
    color: var(--color-accent);
  }

  .hero-heading-sub {
  font-size: 0.35em;
  color: var(--color-accent);
  display: inline;
  white-space: nowrap;
  vertical-align: middle; 
  }

  .hero-tagline {
    font-size: var(--font-size-body-l);
    color: var(--color-text-secondary);
    line-height: var(--line-height-relaxed);
    max-width: 52ch;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-200);
    width: fit-content;
  }

  /* ── Portrait ───────────────────────────────────────────────── */
  .hero-portrait {
    position: relative;
    display: flex;
    justify-content: center;
    align-items: center;
    width: 100%;
    margin-inline: auto;
  }

  @media (min-width: 1024px) {
    .hero-portrait {
      margin-inline: 0;
      justify-content: flex-end;
      justify-self: end;
      width: 100%;
      max-width: none;
    }
  }

  .portrait-halo {
    position: absolute;
    inset: -32px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(200, 255, 73, 0.16) 0%, rgba(200, 255, 73, 0.03) 55%, transparent 75%);
    filter: blur(28px);
    pointer-events: none;
    z-index: 0;
  }

  :global([data-theme="light"]) .portrait-halo {
    background: radial-gradient(circle, rgba(43, 89, 0, 0.12) 0%, transparent 70%);
    filter: blur(22px);
  }

  .portrait-frame {
    position: relative;
    z-index: 2;
    width: clamp(240px, 55vw, 320px);
    aspect-ratio: 1 / 1;
    border-radius: 50%;
    overflow: hidden;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    margin-inline: auto;
    border: 2px solid var(--color-accent);
    box-shadow:
      0 0 24px rgba(200, 255, 73, 0.22),
      0 12px 36px rgba(0, 0, 0, 0.5);
    background: radial-gradient(circle at 55% 35%, #223418 0%, #121c0e 45%, #080c07 100%);
    transition:
      transform var(--motion-normal) var(--motion-easing),
      box-shadow var(--motion-normal) var(--motion-easing);
  }

  @media (min-width: 1024px) {
    .portrait-frame {
      width: clamp(280px, 26vw, 420px);
      margin-inline: 0;
      margin-left: auto;
    }
  }

  :global([data-theme="light"]) .portrait-frame {
    border-color: var(--color-accent);
    background: radial-gradient(circle at 55% 35%, #E1EBD6 0%, #D2E0C5 45%, #C2D4B4 100%);
    box-shadow:
      0 0 20px rgba(43, 89, 0, 0.15),
      0 12px 30px rgba(0, 0, 0, 0.12);
  }

  .hero-portrait:hover .portrait-frame {
    transform: scale(1.02);
    box-shadow:
      0 0 32px rgba(200, 255, 73, 0.35),
      0 16px 44px rgba(0, 0, 0, 0.55);
  }

  .portrait-frame img {
    width: 90%;
    height: 90%;
    object-fit: cover;
    object-position: center top;
    display: block;
    filter: drop-shadow(0 6px 16px rgba(0, 0, 0, 0.4));
  }

  /* ── Buttons ────────────────────────────────────────────────── */
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-150) var(--space-400);
    border-radius: var(--radius-pill);
    font-size: var(--font-size-body);
    font-weight: var(--font-weight-semibold);
    white-space: nowrap;
    min-height: 48px;
    transition:
      background var(--motion-fast) var(--motion-easing),
      border-color var(--motion-fast) var(--motion-easing),
      transform var(--motion-fast) var(--motion-easing),
      box-shadow var(--motion-fast) var(--motion-easing);
  }

  .btn--primary {
    background: var(--color-accent);
    color: var(--color-text-inverse);
  }

  .btn--primary:hover {
    background: #d6ff66;
    transform: translateY(-1px);
    box-shadow: 0 6px 24px rgba(200, 255, 73, 0.3);
  }

  .btn--secondary {
    background: transparent;
    color: var(--color-text-primary);
    border: 1px solid var(--color-border-strong);
  }

  .btn--secondary:hover {
    background: var(--color-bg-surface);
    border-color: var(--color-text-secondary);
  }

  /* ── Focus / Research ───────────────────────────────────────── */
  .focus-section {
    background: var(--color-bg-surface);
    border-top: 1px solid var(--color-border-subtle);
    border-bottom: 1px solid var(--color-border-subtle);
  }

  .skills-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: var(--space-400);
  }

  .skill-group {
    display: flex;
    flex-direction: column;
    gap: var(--space-200);
  }

  .skill-group-title {
    font-size: var(--font-size-label);
    font-family: var(--font-mono);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .skill-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-100);
  }

  .skill-tag {
    font-size: var(--font-size-body-s);
    padding: var(--space-050) var(--space-150);
    border-radius: var(--radius-pill);
    background: rgba(255, 255, 255, 0.05);
    color: var(--color-text-secondary);
    border: 1px solid var(--color-border-subtle);
    transition: color var(--motion-fast) var(--motion-easing),
                border-color var(--motion-fast) var(--motion-easing);
  }

  .skill-tag:hover {
    color: var(--color-text-primary);
    border-color: var(--color-border-strong);
  }

  /* ── Projects grid ──────────────────────────────────────────── */
  .projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: var(--layout-grid-gap);
    margin-bottom: var(--space-600);
  }

  /* ── Articles grid ──────────────────────────────────────────── */
  .articles-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: var(--layout-grid-gap);
    margin-bottom: var(--space-600);
  }

  .section-cta {
    text-align: center;
  }

  /* ── About snapshot ─────────────────────────────────────────── */
  .about-inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-800);
    align-items: start;
  }

  @media (min-width: 1024px) {
    .about-inner {
      grid-template-columns: 1fr 320px;
    }
  }

  .about-text p {
    color: var(--color-text-secondary);
    font-size: var(--font-size-body-l);
    line-height: var(--line-height-relaxed);
    margin-bottom: var(--space-300);
  }

  .about-actions {
    margin-top: var(--space-400);
  }

  .about-card {
    position: sticky;
    top: 88px;
  }

  .about-card-inner {
    background: var(--color-bg-surface);
    border: 1px solid var(--color-border-default);
    border-radius: var(--radius-large);
    padding: var(--space-500);
    display: flex;
    flex-direction: column;
    gap: var(--space-400);
  }

  .about-stat {
    display: flex;
    flex-direction: column;
    gap: var(--space-050);
  }

  .stat-value {
    font-family: var(--font-mono);
    font-size: 1.5rem;
    color: var(--color-accent);
    letter-spacing: -0.02em;
  }

  .stat-label {
    font-size: var(--font-size-body-s);
    color: var(--color-text-secondary);
  }

  /* ── Contact CTA ─────────────────────────────────────────────── */
  .contact-cta .container {
    display: flex;
    justify-content: center;
  }

  .cta-inner {
    background: var(--color-bg-surface);
    border: 1px solid rgba(200, 255, 73, 0.15);
    border-radius: var(--radius-large);
    padding: var(--space-800);
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-400);
    max-width: 600px;
    width: 100%;
  }

  .cta-heading {
    font-size: var(--font-size-heading-l);
    font-weight: var(--font-weight-bold);
    letter-spacing: -0.02em;
  }

  .cta-body {
    font-size: var(--font-size-body-l);
    color: var(--color-text-secondary);
    max-width: 44ch;
    line-height: var(--line-height-relaxed);
  }
</style>
